# Local Docker Compose environment -- a third, deliberately distinct
# variant alongside .env.example (bare local dev, SQLite fallback) and
# .env.production.example (a real deployment). This one's purpose is
# narrower: let anyone with real Docker Hub access (this app's own
# authoring session did not have any -- see the Dockerfile's own top
# comment) actually exercise the real MySQL + Redis path locally,
# against the same image docker-publish.yml ships, before trusting it
# anywhere real. Copy to `.env.docker-compose` -- not `.env`; see
# docker-compose.yml's own header for why that name specifically would
# collide with this repo's real local-dev file -- then run `docker
# compose run --rm app php artisan key:generate --show` once and paste
# the result in below (the same "blank until generated" convention the
# other two env templates already use -- never commit a real APP_KEY),
# then `docker compose up`.
#
# APP_DEBUG=true and MAIL_MAILER=log here, unlike
# .env.production.example -- this file is for comfortable local
# iteration against the real database/cache backends, not a production
# posture rehearsal. Flip both to match .env.production.example's
# values first if that's specifically what you want to verify.

APP_NAME=HRIS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

APP_MAINTENANCE_DRIVER=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# `mysql`/`redis` -- Compose's own service names (see
# docker-compose.yml), resolved via Compose's built-in DNS, not an IP
# or 127.0.0.1 (each service is its own container/network namespace).
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=hris
DB_USERNAME=hris
DB_PASSWORD=hris

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# false, not true -- this stack has no TLS termination in front of it
# locally, unlike .env.production.example's real deployment.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=hris@localhost
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
