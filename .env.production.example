# Production environment template -- blueprint §51 17.19 "Production
# Configuration" / §54 Phase 18. Contrast with .env.example, which is a
# local-dev template and correctly has different defaults for several
# of these same keys (APP_DEBUG=true, MAIL_MAILER=log, etc.) -- that
# file's local-friendly defaults are not a gap to "fix" here, and this
# file's production-hardened defaults are not meant for local dev
# either. Copy to .env on the production host, fill in every blank, and
# never commit the filled-in file (see .gitignore).

APP_NAME=HRIS
APP_ENV=production
APP_KEY=
# Blueprint §51 17.19: APP_DEBUG=false, non-negotiable in production --
# see CLAUDE.md's Security Hardening (Phase 17d) section for why this
# can't be enforced from application code and has to be an environment
# choice made here.
APP_DEBUG=false
APP_URL=https://hris.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

APP_MAINTENANCE_DRIVER=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Blueprint §51 17.21: a dedicated application database user, never
# root, with only the privileges this app actually needs (SELECT,
# INSERT, UPDATE, DELETE, plus CREATE/ALTER/DROP/INDEX for
# `php artisan migrate` -- nothing broader).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hris
DB_USERNAME=hris
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Blueprint §51 17.8: cookies must only ever be sent over HTTPS in
# production. Left unset, Laravel infers this from the current
# request's own scheme -- explicit here so it can never silently be
# "off" behind a misconfigured reverse proxy that terminates TLS
# upstream of the app without forwarding X-Forwarded-Proto correctly.
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

# A real transport, not `log` -- security-relevant mail (SecurityAlert,
# password resets, PayslipPublished, TrainingCertificateExpiring) has
# to actually reach recipients in production. smtp shown; ses/postmark/
# resend are equally valid, see config/mail.php for their required keys.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
